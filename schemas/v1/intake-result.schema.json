{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopbase.dev/schemas/v1/intake-result.schema.json",
  "title": "Loopbase Goal Intake Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "goal",
    "goal_draft",
    "missing_information",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "intake-result/v1"
    },
    "status": {
      "enum": ["ready", "needs_clarification"]
    },
    "goal": {
      "oneOf": [
        {"$ref": "goal.schema.json"},
        {"type": "null"}
      ]
    },
    "goal_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "success_criteria", "constraints", "context"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "success_criteria": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "constraints": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "context": {"type": "object"}
      }
    },
    "missing_information": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "questions": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
