{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopbase.dev/schemas/v1/execution-result.schema.json",
  "title": "Loopbase Execution Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_id",
    "status",
    "final_answer",
    "task_plan",
    "task_records"
  ],
  "properties": {
    "schema_version": {
      "const": "execution-result/v1"
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["completed", "failed", "blocked"]
    },
    "final_answer": {
      "type": ["string", "null"]
    },
    "task_plan": {
      "$ref": "task-plan.schema.json"
    },
    "task_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "status",
          "output",
          "error",
          "turns",
          "stopped_by",
          "tool_calls_executed",
          "started_at",
          "finished_at"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["completed", "failed"]
          },
          "output": {
            "type": ["string", "null"]
          },
          "error": {
            "type": ["string", "null"]
          },
          "turns": {
            "type": "integer",
            "minimum": 0
          },
          "stopped_by": {
            "type": "string"
          },
          "tool_calls_executed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "started_at": {
            "type": "number",
            "minimum": 0
          },
          "finished_at": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
