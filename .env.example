# 复制为 .env 后填写。已存在的环境变量优先，.env 不会覆盖。

# 默认走 DeepSeek：
DEEPSEEK_API_KEY=sk-xxx
LOOPBASE_BASE_URL=https://api.deepseek.com/v1
LOOPBASE_MODEL=deepseek-chat

# 改用 Moonshot Kimi 时，注释上面的 DeepSeek 三行，换成：
# MOONSHOT_API_KEY=sk-xxx
# LOOPBASE_BASE_URL=https://api.moonshot.cn/v1
# LOOPBASE_MODEL=kimi-k3

# Alpha Vantage（金融工具数据源，免费注册：https://www.alphavantage.co/support/#api-key）
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
