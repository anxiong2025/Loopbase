{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "loopbase-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--package", "api", "uvicorn", "api.main:app", "--reload", "--port", "8010"],
      "port": 8010
    },
    {
      "name": "loopbase-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/web", "dev", "--port", "3000"],
      "port": 3000
    }
  ]
}
